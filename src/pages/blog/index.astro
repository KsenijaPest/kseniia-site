---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout
  title="Blog"
  description="Paid search and PPC insights from 10+ years running Google Ads and Microsoft Ads accounts at scale."
>
  <section>
    <h1>Blog</h1>
    <p>Notes from running Google Ads and Microsoft Ads accounts spending over $100,000 a day, for lead generation and e-commerce businesses across a range of industries.</p>
  </section>

  <section class="post-list">
    {allPosts.map((post) => (
      <a href={`/blog/${post.id}/`} class="split-card post-card">
        <p class="post-date">{post.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p>
        <h2>{post.data.title}</h2>
        <p class="post-desc">{post.data.description}</p>
      </a>
    ))}
    {allPosts.length === 0 && <p>New posts coming soon.</p>}
  </section>
</Layout>

<style>
  .post-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .post-card { display: block; text-decoration: none; color: inherit; }
  .post-card:hover { border-color: var(--color-accent); }
  .post-date { color: var(--color-muted); font-size: 0.85rem; margin: 0 0 0.5rem; }
  .post-card h2 { margin-bottom: 0.5rem; }
  .post-desc { color: var(--color-ink); margin: 0; }
</style>
