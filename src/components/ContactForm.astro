---
interface Props { source?: string; compact?: boolean; }
const { source = 'contact-page', compact = false } = Astro.props;
const prefix = `inquiry-${source}`;
---
<form action="https://api.web3forms.com/submit" method="POST" data-inquiry-form data-source={source} class:list={{ compact }}>
  <input type="hidden" name="access_key" value="067d94ff-2b9f-4d41-9199-09d942719de8" />
  <input type="hidden" name="redirect" value="https://kseniiashermin.com/thank-you/" />
  <input type="hidden" name="form_source" value={source} />
  <label for={`${prefix}-name`}>Name</label>
  <input id={`${prefix}-name`} name="name" autocomplete="name" required />
  <label for={`${prefix}-email`}>Email</label>
  <input type="email" id={`${prefix}-email`} name="email" autocomplete="email" required />
  <label for={`${prefix}-interest`}>What are you looking for?</label>
  <select id={`${prefix}-interest`} name="interest" required>
    <option value="" selected disabled>Select an option</option>
    <option>Audit</option>
    <option>Consultation</option>
    <option>Ongoing management</option>
    <option>Full-time / fractional role</option>
    <option>Not sure yet</option>
  </select>
  {!compact && <div data-budget-field>
    <label for={`${prefix}-budget`}>Approximate monthly ad spend <span>(optional)</span></label>
    <select id={`${prefix}-budget`} name="budget">
      <option value="">Select a range (optional)</option>
      <option>Under $10,000</option>
      <option>$10,000 - $50,000</option>
      <option>$50,000 - $200,000</option>
      <option>$200,000+</option>
    </select>
  </div>}
  <label for={`${prefix}-message`} data-message-label>What would you like to discuss? <span>(optional)</span></label>
  <textarea id={`${prefix}-message`} name="message" rows={compact ? 2 : 4}></textarea>
  <p class="form-privacy">Your details are used to reply to your inquiry. <a href="/privacy-policy/">Privacy policy</a>.</p>
  <button type="submit" class="btn btn-primary">Send inquiry &rarr;</button>
  <p class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
    const interest = form.elements.namedItem('interest') as HTMLSelectElement;
    const budget = form.elements.namedItem('budget') as HTMLSelectElement | null;
    const budgetField = form.querySelector<HTMLElement>('[data-budget-field]');
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    const requested = new URLSearchParams(location.search).get('interest');
    if (requested && Array.from(interest.options).some(option => option.value === requested)) interest.value = requested;
    const updateIntent = () => {
      const hiring = interest.value === 'Full-time / fractional role';
      if (budgetField) budgetField.hidden = hiring;
      if (budget) budget.disabled = hiring;
      const label = form.querySelector('[data-message-label]');
      if (label) label.innerHTML = `${hiring ? 'Tell me about the role, team, and opportunity' : 'What would you like to discuss?'} <span>(optional)</span>`;
    };
    updateIntent();
    interest.addEventListener('change', updateIntent);
    let started = false;
    let sending = false;
    let completed = false;
    const track = (name: string, intent = interest.value || 'unspecified') => document.dispatchEvent(new CustomEvent('inquiry-analytics', {
      detail: { name, source: form.dataset.source, intent }
    }));
    form.addEventListener('input', () => {
      if (!started) { started = true; track('inquiry_start'); }
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending || completed) return;
      sending = true;
      button.disabled = true;
      button.textContent = 'Sending...';
      status.hidden = false;
      status.textContent = 'Sending your inquiry.';
      const payload = new FormData(form);
      payload.delete('redirect');
      const submittedIntent = interest.value;
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea'));
      const disabledBefore = fields.map(field => field.disabled);
      fields.forEach(field => field.disabled = true);
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(form.action, {
          method: 'POST', body: JSON.stringify(Object.fromEntries(payload)),
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, signal: controller.signal
        });
        const result = await response.json();
        if (!response.ok || result.success !== true) throw new Error('Submission not confirmed');
        completed = true;
        track('form_submission', submittedIntent);
        status.textContent = "Thanks, your inquiry was sent. I'll follow up within 1-2 business days.";
        button.textContent = 'Inquiry sent';
      } catch {
        status.textContent = "I couldn't confirm delivery. Your details are still here. You can try again, or use the booking link on this page. If your first attempt arrived, a retry may send a duplicate.";
        button.disabled = false;
        button.textContent = 'Try sending again';
      } finally {
        clearTimeout(timeout);
        sending = false;
        if (!completed) fields.forEach((field, index) => field.disabled = disabledBefore[index]);
        status.focus();
      }
    });
  });
</script>
<style>
 form, [data-budget-field] { display: grid; gap: .55rem; }
 [hidden] { display: none; }
 label { font-size: .9rem; font-weight: 650; margin-top: .6rem; }
 label :global(span) { font-weight: 400; color: var(--color-muted); }
 input, select, textarea { width: 100%; min-width: 0; padding: .8rem; background: #fff; color: var(--color-ink); border: 1px solid #b9c0ca; border-radius: 6px; font: inherit; }
 textarea { resize: vertical; }
 .form-privacy { color: var(--color-muted); font-size: .78rem; margin: .8rem 0; }
 button { cursor: pointer; width: 100%; }
 button:disabled { opacity: .7; cursor: default; transform: none; }
 .form-status { padding: 1rem; border: 1px solid var(--color-line); border-radius: 6px; font-size: .9rem; margin-bottom: 0; }
 .compact { gap: .35rem; }
 .compact label { margin-top: .35rem; }
 .compact input, .compact select, .compact textarea { padding: .65rem; }
</style>
