---
import Layout from '../layouts/Layout.astro';

// TODO: fill in real values before publishing, then update the FAQPage schema below.
const MIN_BUDGET = "[FILL IN: e.g. $10,000/month]";
const RESULTS_TIMELINE = "[FILL IN: e.g. 60-90 days]";
const NDA_ANSWER = "[FILL IN: yes/no + details]";
const TEAM_ANSWER = "[FILL IN: independently / with a team]";
const LAST_UPDATED = "August 2026";

const faqs = [
  {
    q: "What's included in a paid search audit?",
    a: "A full review of account structure, tracking accuracy, budget allocation, and bidding strategy across Google Ads and/or Microsoft Ads, with a prioritized list of what to fix first."
  },
  {
    q: "What's the minimum budget you work with?",
    a: MIN_BUDGET
  },
  {
    q: "How fast will I see results?",
    a: RESULTS_TIMELINE
  },
  {
    q: "Do you work with e-commerce accounts?",
    a: "My focus is lead generation for B2B and service businesses, not e-commerce."
  },
  {
    q: "Which platforms do you work with?",
    a: "Google Ads, Microsoft Ads, Meta Ads, LinkedIn Ads, and other PPC platforms depending on where your audience is."
  },
  {
    q: "Do you sign NDAs?",
    a: NDA_ANSWER
  },
  {
    q: "Do you work independently or with a team?",
    a: TEAM_ANSWER
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const servicesSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Google Ads / Microsoft Ads / Meta Ads Audit",
    "provider": { "@type": "Person", "name": "Kseniia Shermin" },
    "description": "A full review of account structure, tracking accuracy, budget allocation, and bidding strategy, with a prioritized list of what to fix first."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Performance Marketing Consultation",
    "provider": { "@type": "Person", "name": "Kseniia Shermin" },
    "description": "A focused strategy session on paid search or paid social for lead generation accounts."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Paid Search & Paid Social Management",
    "provider": { "@type": "Person", "name": "Kseniia Shermin" },
    "description": "Ongoing management of Google Ads, Microsoft Ads, and/or Meta Ads accounts for lead generation."
  }
];
---

<Layout
  title="Work With Me"
  description="Audits, consultations, and account management for Google Ads, Microsoft Ads, and Meta Ads &mdash; focused on lead generation for B2B and service businesses."
  schema={[faqSchema, ...servicesSchema]}
>
  <section>
    <h1>Work With Me</h1>
    <p>Lead generation focused paid search and paid social, for B2B and service businesses &mdash; not e-commerce.</p>
  </section>

  <section id="audit">
    <h2>Audit</h2>
    <p>A full review of account structure, tracking accuracy, budget allocation, and bidding strategy across Google Ads and/or Microsoft Ads, with a prioritized list of what to fix first.</p>
    <a href="/contact" class="btn btn-primary">Request an Audit</a>
  </section>

  <section id="consultation">
    <h2>Consultation</h2>
    <p>A focused strategy session &mdash; bring your specific questions or roadblocks, leave with a concrete plan.</p>
    <a href="/contact" class="btn btn-secondary">Book a Call</a>
  </section>

  <section id="management">
    <h2>Account Management</h2>
    <p>Ongoing, hands-on management of your Google Ads, Microsoft Ads, and/or Meta Ads accounts, built around a predictable lead pipeline.</p>
    <a href="/contact" class="btn btn-secondary">Get in Touch</a>
  </section>

  <section>
    <h2>FAQ</h2>
    {faqs.map((item) => (
      <div class="faq-item">
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </div>
    ))}
    <p class="updated-note">Updated: {LAST_UPDATED}</p>
  </section>
</Layout>
