---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Kseniia Shermin",
  "jobTitle": "Performance Marketing Manager",
  "description": "10+ years of experience in paid search and paid social, specializing in lead generation for B2C, B2B, and service businesses.",
  "url": "https://kseniiashermin.com/about"
};

const testimonials = [
  {
    quote: "Sienna is a terrific SEM manager! She is extremely knowledgeable about all things Google Ads and she knows how to deliver results. During the high seasons in our business, Sienna always showed up ready to deliver value, regardless of how long the hours were. Thank you Sienna for all the support and hard work!!!",
    name: "Rodolfo Marrero",
    title: "CTO & Co-Founder at Excel Impact, LLC",
    context: "LinkedIn recommendation, November 2024"
  },
  {
    quote: "I had the chance to work with Sienna on several projects in the behavioral healthcare space. She has strong experience with Paid Search, lead generation, and campaign management across Google and Bing Ads, including large daily budgets over $100K. What I liked about working with her was that she always focused not just on traffic, but on lead quality and overall business goals. She understands healthcare marketing well, works great with the team, and is very organized and professional in her work. Sienna is very experienced in PPC and digital marketing, and I'd definitely recommend her to any company looking for a strong paid search specialist.",
    name: "Georgii Liapko",
    title: "Senior SEO & Digital Marketing Manager",
    context: "LinkedIn recommendation, May 2026"
  },
  {
    quote: "Meeting Kseniia was a great pleasure. She's extremely knowledgeable about PPC, both on Google and Bing, something many people claim to know, but few actually possess. I highly recommend her for any project, especially if it involves insurance.",
    context: "30 minute consultation",
    rating: 5
  },
  {
    quote: "Kseniia did several PPC audits for us and she was insightful, succinct and technically very proficient. I wouldn't have any hesitation working with her again.",
    context: "PPC expert for ongoing agency work, large ad spend management",
    rating: 5
  },
  {
    quote: "Great media buyer and communicator. Highly recommend.",
    context: "Paid search, call only focus",
    rating: 5
  },
  {
    quote: "Great to work with, very accommodating and knowledgeable; would definitely work with again.",
    context: "YouTube Ads setup",
    rating: 5
  },
  {
    quote: "Ksenilia is an excellent communicator, and she innovates in the creation of ads and selection of keywords, etc. She is constantly seeking to improve and she does a GREAT job. We love her A+++++",
    context: "Google Ads search campaigns setup",
    rating: 5
  }
];
---

<Layout
  title="About"
  description="Performance Marketing Manager with 10+ years of experience in paid search and paid social lead generation."
  schema={schema}
>
  <section>
    <h1>About Me</h1>
    <p>
      I'm a Performance Marketing Manager with 10+ years of experience in paid search
      and paid social. I manage large-scale Google Ads and Microsoft Ads accounts,
      spending over $100,000 per day, alongside Meta Ads, LinkedIn Ads, and other
      PPC platforms, working with any bidding logic or campaign structure the account
      requires. My focus is lead generation: turning "we just need more leads" into a
      predictable, forecastable pipeline.
    </p>

    <!-- TODO: add Google Ads / Microsoft Advertising certifications here as trust badges -->
  </section>

  <section class="career-history">
    <h2>Career History</h2>

    <div class="career-role">
      <h3>Director of Marketing, P7 Ventures</h3>
      <p class="career-meta">May 2024 to July 2026, Remote</p>
      <ul>
        <li>Led multi-channel paid search strategy across all business units, managing vendors and hitting aggressive CPA and volume targets</li>
        <li>Architected automated data pipelines using n8n for real-time ROI tracking and full performance transparency</li>
      </ul>
    </div>

    <div class="career-role">
      <h3>Founder &amp; PPC Consultant, Smart PPC</h3>
      <p class="career-meta">May 2023 to May 2024</p>
      <ul>
        <li>Ran an independent PPC consultancy: audits, strategic consulting, and new account builds for businesses and digital agencies</li>
        <li>Partnered with multiple digital agencies as a senior PPC specialist, managing key client accounts and leading campaign teams</li>
      </ul>
    </div>

    <div class="career-role">
      <h3>Head of PPC / Senior PPC Strategist / PPC Specialist, Excel&trade;</h3>
      <p class="career-meta">April 2018 to June 2022</p>
      <ul>
        <li>Built and managed PPC campaigns across Google Ads, Bing Ads, and Meta Ads, managing daily budgets of $100,000+</li>
        <li>Recruited, trained, and managed a team of PPC specialists</li>
      </ul>
    </div>

    <div class="career-role">
      <h3>PPC Specialist, Lead Box</h3>
      <p class="career-meta">June 2015 to April 2018</p>
      <ul>
        <li>Grew monthly orders 36x and reduced cost per order 2.5x</li>
        <li>Built a Power BI analytics system from scratch, including the data model and reporting used for marketing and management decisions</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>How I Work</h2>
    <div class="split-cards">
      <div class="split-card">
        <h3>Start with the goal, not the tactic</h3>
        <p>I focus on the number that actually matters, usually lowering cost per action and scaling conversion volume at the same time, not one at the expense of the other.</p>
      </div>
      <div class="split-card">
        <h3>Fix the foundation first</h3>
        <p>Before touching bids or creative, I make sure tracking and data are accurate. Every scaling decision after that is only as good as the data it's built on.</p>
      </div>
      <div class="split-card">
        <h3>Then experiment relentlessly</h3>
        <p>Once the foundation is solid, I test across every layer of the account, including bidding strategy, audience signals, ad copy, and landing pages, to find what actually moves the number.</p>
      </div>
    </div>
  </section>

  <section>
    <h2>What Clients &amp; Colleagues Say</h2>
    <div class="split-cards testimonial-grid">
      {testimonials.map((t) => (
        <div class="split-card testimonial-card">
          {t.screenshot ? (
            <img src={t.screenshot} alt={`LinkedIn recommendation from ${t.name}`} loading="lazy" />
          ) : (
            <>
              {t.rating && (
                <p class="testimonial-stars" aria-label={`${t.rating} out of 5 stars`}>{"★".repeat(t.rating)}</p>
              )}
              <p class="testimonial-quote">&ldquo;{t.quote}&rdquo;</p>
            </>
          )}
          {t.name && <p class="testimonial-name">{t.name}, {t.title}</p>}
          <p class="testimonial-context">{t.context}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .career-role {
    border-bottom: 1px solid var(--color-line);
    padding: 1.5rem 0;
  }
  .career-role:last-child { border-bottom: none; }
  .career-role h3 { font-family: var(--font-sans); font-size: 1.1rem; margin-bottom: 0.2rem; }
  .career-meta { color: var(--color-muted); font-size: 0.9rem; margin-top: 0; margin-bottom: 0.75rem; }
  .career-role ul { margin: 0; padding-left: 1.2rem; }
  .career-role li { margin-bottom: 0.4rem; }

  .testimonial-grid { grid-template-columns: 1fr 1fr; }
  @media (max-width: 640px) { .testimonial-grid { grid-template-columns: 1fr; } }
  .testimonial-card { display: flex; flex-direction: column; }
  .testimonial-stars { color: #e0a821; letter-spacing: 0.15em; margin: 0 0 0.5rem; font-size: 1.1rem; }
  .testimonial-quote { flex: 1; font-style: italic; }
  .testimonial-name { font-weight: 600; margin-top: 1rem; margin-bottom: 0; }
  .testimonial-context { color: var(--color-muted); font-size: 0.85rem; margin-top: 0.2rem; }
  .testimonial-card img { width: 100%; height: auto; border-radius: 4px; margin-bottom: 0.75rem; }
</style>
