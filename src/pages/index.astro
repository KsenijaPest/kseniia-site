---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getLastUpdated } from '../lib/updated';
import ContactSection from '../components/ContactSection.astro';
import QuickInquiry from '../components/QuickInquiry.astro';
import { caseStudies } from '../data/case-studies';
import { testimonials } from '../data/testimonials';
import { faqs } from '../data/faqs';
import { getCollection } from 'astro:content';
import heroPhoto from '../assets/kseniia-shermin.jpg';

const LAST_UPDATED = getLastUpdated();
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) };

const industries = [
  "Health Insurance (ACA)",
  "Health Insurance (U65)",
  "Medicare (O65)",
  "Life & Final Expense Insurance",
  "Auto & Home Insurance",
  "Mental Health & Behavioral Health Treatment",
  "Telecom & Internet Service Providers",
  "E-commerce (Home Appliances & Consumer Goods)",
  "B2B SaaS"
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://kseniiashermin.com/#person",
  "image": "https://kseniiashermin.com/kseniia-shermin.jpg",
  "name": "Kseniia Shermin",
  "jobTitle": "Performance Marketing Manager",
  "description": "Performance Marketing Manager specializing in lead generation at scale across Google Ads, Microsoft Ads, and Meta Ads.",
  "url": "https://kseniiashermin.com",
  "sameAs": [
    "https://www.linkedin.com/in/kseniiashermin/"
  ],
  "knowsAbout": [
    "Google Ads", "Microsoft Ads", "Meta Ads", "Paid Search", "PPC", "SEM",
    ...industries
  ]
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://kseniiashermin.com/#professionalservice",
  "url": "https://kseniiashermin.com",
  "founder": { "@id": "https://kseniiashermin.com/#person" },
  "name": "Kseniia Shermin - Performance Marketing",
  "description": "Lead generation focused paid search and paid social consulting for B2C, B2B, and service businesses. Google Ads, Microsoft Ads, and Meta Ads audits, consultations, and account management.",
  "areaServed": "Worldwide",
  "priceRange": "$$$"
};
---

<Layout
  title="Performance Marketing Manager | Google Ads & Microsoft Ads"
  description="10+ years in paid search and paid social, with $100K+ daily ad spend managed. Explore real results, request a PPC audit, or discuss a full-time or fractional role."
  schema={[personSchema, professionalServiceSchema, faqSchema]}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">KSENIIA SHERMIN / PERFORMANCE MARKETING MANAGER</p>
      <h1 id="hero-heading">Paid search.<br />Lead quality.<br /><em>Room to scale.</em></h1>
      <p class="hero-description">I help B2C, B2B, and service businesses grow through Google Ads, Microsoft Ads, and paid social. Hands-on account management, from tracking foundations to scaling acquisition.</p>
      <div class="cta-buttons">
        <button class="btn btn-primary" type="button" data-open-inquiry>Let's talk about your account &rarr;</button>
        <a href="#results" class="hero-proof-link">See the results &darr;</a>
      </div>
      <p class="hiring-link">Building your team? <a href="#for-employers">Explore full-time &amp; fractional fit &rarr;</a></p>
    </div>
    <div class="hero-visual">
      <span class="portrait-marker" aria-hidden="true">KS /</span>
      <Image class="hero-photo" src={heroPhoto} width={660} height={760} format="webp" quality={85} loading="eager" fetchpriority="high" alt="Kseniia Shermin, Performance Marketing Manager" />
      <div class="portrait-note"><span>STRATEGY + HANDS-ON EXECUTION</span><strong>Built around business goals.</strong></div>
    </div>
  </section>

  <section class="proof-strip" aria-label="Experience at a glance">
    <div><strong>10+</strong><span>Years of experience</span></div>
    <div><strong>$100K+</strong><span>Daily ad spend managed</span></div>
    <div class="platform-line"><span>PAID SEARCH &amp; PAID SOCIAL</span><p>Google Ads · Microsoft Ads<br />Meta Ads · LinkedIn Ads</p></div>
  </section>

  <section id="results">
    <div class="section-heading"><div><p class="eyebrow">SELECTED RESULTS</p><h2>Real accounts. Real outcomes.</h2></div><a class="text-link" href="/case-studies">All case studies &rarr;</a></div>
    <div class="results-grid">
      {caseStudies.map((cs, index) => (
        <a href={`/case-studies#case-${index + 1}`} class="result-card">
          <div class="result-top"><span>{cs.vertical}</span><span aria-hidden="true">↗</span></div>
          <strong class="result-number">{cs.stat.number}</strong>
          <p class="result-label">{cs.stat.label}</p>
          <h3>{cs.name}</h3>
          <p>{cs.result}</p>
          <span class="result-link">See the context &amp; work behind it &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="recommendation">
    <p class="eyebrow">FROM A COLLEAGUE</p>
    <blockquote>{testimonials[0].quote}</blockquote>
    <div class="quote-credit"><p><strong>{testimonials[0].name}</strong><br />{testimonials[0].title}<br /><span>{testimonials[0].context}</span></p><a class="text-link" href="/about">More client &amp; colleague feedback &rarr;</a></div>
  </section>

  <section id="services">
    <div class="section-heading"><div><p class="eyebrow">WORK WITH ME</p><h2>Start where your account needs help.</h2></div></div>
    <div class="service-grid">
      <article class="service-card"><span class="service-index">01 / DIAGNOSE</span><h3>Paid search audit</h3><p>A full review of account structure, tracking accuracy, budget allocation, and bidding strategy across Google Ads and/or Microsoft Ads, with a prioritized list of what to fix first.</p><a class="text-link" href="/contact?interest=Audit">Request a paid audit &rarr;</a></article>
      <article class="service-card"><span class="service-index">02 / PLAN</span><h3>Consultation</h3><p>A focused strategy session. Bring your specific questions or roadblocks, leave with a concrete plan.</p><a class="text-link" href="/contact?interest=Consultation">Discuss a consultation &rarr;</a></article>
      <article class="service-card"><span class="service-index">03 / BUILD &amp; SCALE</span><h3>Ongoing management</h3><p>Ongoing, hands-on management of your Google Ads, Microsoft Ads, and/or Meta Ads accounts, built around a predictable lead pipeline.</p><a class="text-link" href="/contact?interest=Ongoing%20management">Discuss your account &rarr;</a></article>
    </div>
    <p class="service-note">Not sure which fits? <a href="https://cal.com/kseniiashermin/15min" target="_blank" rel="noopener">Start with a free intro call &nearr;</a></p>
  </section>
  <section class="platforms" id="expertise">
    <p class="eyebrow">PLATFORM EXPERTISE</p>
    <h2>Paid search is where I live.</h2>
    <p>
      Paid search is where I live. Over 10 years running Google Ads and Microsoft Ads
      accounts at scale means knowing the auction mechanics, the bid strategy tradeoffs,
      and the reporting quirks well enough to know when to trust the platform's automation
      and when to override it.
    </p>
    <div class="split-cards">
      <div class="split-card platform-card">
        <svg class="platform-logo" viewBox="0 0 48 48" width="40" height="40" role="img" aria-label="Google Ads">
          <path fill="#4285F4" d="M24 9.5c3.4 0 6.4 1.2 8.8 3.5l6.6-6.6C35.5 2.6 30.1 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.7 6c1.8-5.5 7-9.7 13.7-9.7Z"/>
          <path fill="#34A853" d="M46.5 24.5c0-1.6-.1-3.2-.4-4.7H24v9h12.6c-.5 3-2.2 5.5-4.7 7.2l7.3 5.7c4.3-4 6.8-9.9 6.8-17.2Z"/>
          <path fill="#FBBC05" d="M10.3 28.5a14.5 14.5 0 0 1 0-9l-7.7-6a24 24 0 0 0 0 21l7.7-6Z"/>
          <path fill="#EA4335" d="M24 48c6.1 0 11.3-2 15-5.5l-7.3-5.7c-2 1.4-4.7 2.2-7.7 2.2-6.6 0-12.2-4.5-14.2-10.5l-7.7 6C6.5 42.6 14.6 48 24 48Z"/>
        </svg>
        <h3>Google Ads</h3>
        <p>Search, Display, Performance Max, Shopping, and YouTube. Comfortable building account structures for scale, tuning Smart Bidding strategies, and getting conversion tracking right before touching anything else.</p>
      </div>
      <div class="split-card platform-card">
        <svg class="platform-logo" viewBox="0 0 24 24" width="40" height="40" role="img" aria-label="Microsoft Ads">
          <rect x="1" y="1" width="10" height="10" fill="#F25022"/>
          <rect x="13" y="1" width="10" height="10" fill="#7FBA00"/>
          <rect x="1" y="13" width="10" height="10" fill="#00A4EF"/>
          <rect x="13" y="13" width="10" height="10" fill="#FFB900"/>
        </svg>
        <h3>Microsoft Ads</h3>
        <p>Microsoft Ads is not just an import job from Google Ads. It's a genuinely different platform with its own auction dynamics and audience network, and it rewards a different approach. Years of hands-on Microsoft Ads campaign management have consistently delivered strong traffic, lead quality, and ROI.</p>
      </div>
    </div>
    <p class="platforms-also"><strong>Also experienced with:</strong> Meta Ads, LinkedIn Ads, and other PPC platforms depending on where the audience actually is.</p>
  </section>

  <section class="industries" id="industries">
    <h2>Industries</h2>
    <p>
      I've run paid search and lead generation campaigns across health insurance (ACA, U65,
      and Medicare O65), life and final expense insurance, auto and home insurance, mental
      health and behavioral health treatment, telecom and internet service providers,
      e-commerce, including home appliances and consumer goods, and B2B SaaS.
    </p>
    <ul class="industry-tags">
      {industries.map((industry) => <li>{industry}</li>)}
    </ul>
  </section>

  <section class="philosophy">
    <h2>How I Work</h2>
    <p><strong>Start with the goal, not the tactic.</strong> I focus on the number that actually matters, usually lowering cost per action and scaling conversion volume at the same time, not one at the expense of the other.</p>
    <p><strong>Fix the foundation first.</strong> Before touching bids or creative, I make sure tracking and data are accurate. Every scaling decision after that is only as good as the data it's built on.</p>
    <p><strong>Then experiment relentlessly.</strong> Once the foundation is solid, I test across every layer of the account, including bidding strategy, audience signals, ad copy, and landing pages, to find what actually moves the number.</p>
  </section>


  <section class="employer-panel" id="for-employers">
    <div><p class="eyebrow">FOR HIRING MANAGERS</p><h2>A strategic lead.<br />A hands-on operator.</h2><p>10+ years of in-house and agency-side experience managing large-scale lead gen accounts. Open to full-time and fractional Performance Marketing Manager roles.</p><div class="cta-buttons"><a href="/contact?interest=Full-time%20%2F%20fractional%20role" class="btn btn-primary">Discuss a role &rarr;</a><a href="/for-employers" class="text-link">More for employers &rarr;</a></div></div>
    <div class="career-preview"><p class="eyebrow">EXPERIENCE</p><h3>Director of Marketing</h3><p>P7 Ventures · May 2024 to July 2026</p><h3>Founder &amp; PPC Consultant</h3><p>Smart PPC · May 2023 to May 2024</p><h3>Head of PPC / Senior PPC Strategist / PPC Specialist</h3><p>Excel™ · April 2018 to June 2022</p><a class="text-link" href="/about#career">View complete career history &rarr;</a></div>
  </section>

  {posts.length > 0 && <section class="insight"><p class="eyebrow">FROM THE BLOG</p><a href={`/blog/${posts[0].id}/`}><h2>{posts[0].data.title}</h2><span class="text-link">Read the article &rarr;</span></a></section>}

  <section class="faq-section"><div><p class="eyebrow">BEFORE WE TALK</p><h2>A few useful answers.</h2><a class="text-link" href="/services">Explore services &rarr;</a></div><div>{faqs.map(item => <details class="faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
  <ContactSection />
  <p class="updated-note">Updated: {LAST_UPDATED}</p>
  <QuickInquiry />
</Layout>

<style>
 .hero { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 4rem; padding: 2rem 0 3.5rem; margin-bottom: 0; }
 .hero h1 { font-size: clamp(3.2rem, 5.5vw, 5rem); line-height: 1.04; letter-spacing: -.055em; margin: 1.25rem 0 1.5rem; }
 .hero h1 em { color: var(--color-accent); font-style: normal; }
 .hero-description { max-width: 35rem; font-size: 1.08rem; color: #4c5360; }
 .hero .cta-buttons { align-items: center; gap: 1.5rem; margin-top: 2rem; }
 .hero-proof-link { color: var(--color-ink); font-size: .9rem; font-weight: 650; text-decoration: none; }
 .hiring-link { margin-top: 1.5rem; font-size: .8rem; color: var(--color-muted); }
 .hero-visual { position: relative; background: #e6e9e4; padding: 1.25rem 1.25rem 0; border-radius: 120px 12px 12px 12px; }
 .hero-photo { width: 100%; height: 430px; display: block; object-fit: cover; object-position: center 30%; border-radius: 105px 5px 0 0; }
 .portrait-marker { position: absolute; z-index: 1; top: 1.2rem; right: 1.9rem; font: italic 2.2rem var(--font-serif); color: white; }
 .portrait-note { background: var(--color-ink); color: white; padding: 1.2rem 1.4rem; margin: 0 -1.25rem; border-radius: 0 0 12px 12px; }
 .portrait-note span { display: block; font-size: .6rem; letter-spacing: .13em; color: #c1c9d6; margin-bottom: .25rem; }
 .portrait-note strong { font-weight: 500; }
 .proof-strip { display: grid; grid-template-columns: 1fr 1fr 1.3fr; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: 1.8rem 0; gap: 2rem; }
 .proof-strip > div { display: flex; flex-direction: column; padding-left: 1.5rem; border-left: 1px solid var(--color-line); }
 .proof-strip > div:first-child { padding: 0; border: 0; }
 .proof-strip strong { font-size: 2.7rem; line-height: 1.2; letter-spacing: -.05em; }
 .proof-strip span { color: var(--color-muted); font-size: .8rem; }
 .platform-line span { font-size: .65rem; letter-spacing: .1em; }
 .platform-line p { margin: .5rem 0 0; font-weight: 550; }
 .results-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
 .result-card { display: flex; flex-direction: column; padding: 2rem; border: 1px solid var(--color-line); border-radius: 10px; background: #fff; color: var(--color-ink); text-decoration: none; }
 .result-top { display: flex; justify-content: space-between; gap: 1rem; font-size: .75rem; color: var(--color-muted); }
 .result-top > span:last-child { font-size: 1.3rem; color: var(--color-accent); }
 .result-number { font-size: 3.7rem; letter-spacing: -.06em; color: var(--color-accent); margin-top: 1.2rem; line-height: 1.1; }
 .result-label { margin: .4rem 0 1.75rem; font-size: .9rem; }
 .result-card h3 { font: 650 1.15rem var(--font-sans); }
 .result-card > p:not(.result-label) { font-size: .9rem; color: var(--color-muted); margin: .3rem 0 1.5rem; }
 .result-link { font-size: .8rem; font-weight: 650; margin-top: auto; }
 .recommendation { padding: 2.5rem 3rem; background: #e9edf3; border-radius: 10px; }
 .recommendation blockquote { margin: 1.2rem 0; font: 1.6rem/1.5 var(--font-serif); }
 .quote-credit { display: flex; align-items: end; justify-content: space-between; gap: 2rem; font-size: .8rem; }
 .quote-credit p { margin-bottom: 0; }.quote-credit span { color: var(--color-muted); }
 .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
 .service-card { border-top: 2px solid var(--color-ink); padding: 1.4rem 0; display: flex; flex-direction: column; }
 .service-index { color: var(--color-muted); font-size: .65rem; letter-spacing: .12em; margin-bottom: 1.2rem; }
 .service-card h3 { font: 650 1.3rem var(--font-sans); }
 .service-card p { color: var(--color-muted); font-size: .95rem; }
 .service-card a { margin-top: auto; padding-top: 1rem; }
 .service-note { font-size: .9rem; }
 .platform-logo { display: block; margin-bottom: 1.5rem; }.platforms-also { color: var(--color-muted); font-size: .9rem; }
 .industry-tags { display: flex; flex-wrap: wrap; gap: .6rem; padding: 0; list-style: none; }
 .industry-tags li { border: 1px solid var(--color-line); border-radius: 5px; padding: .45rem .8rem; font-size: .8rem; }
 .industries { padding-top: 2rem; border-top: 1px solid var(--color-line); }
 .philosophy { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }.philosophy h2 { grid-column: 1 / -1; }.philosophy p { margin: 0; color: var(--color-muted); font-size: .95rem; }.philosophy strong { display: block; margin-bottom: .7rem; color: var(--color-ink); }
 .employer-panel { display: grid; grid-template-columns: 1.2fr 1fr; gap: 4rem; background: #172538; color: #fff; border-radius: 12px; padding: 3rem; }.employer-panel .eyebrow { color: #b4c6df; }.employer-panel p { color: #cbd4df; }.employer-panel .text-link { color: #d2e0ff; }.employer-panel .cta-buttons { align-items: center; margin-top: 1.75rem; }.career-preview { border-left: 1px solid #455467; padding-left: 2rem; }.career-preview h3 { font: 550 1rem/1.4 var(--font-sans); }.career-preview p { font-size: .78rem; margin: .4rem 0 1.5rem; }
 .insight { border-block: 1px solid var(--color-line); padding: 2rem 0; }.insight > a { text-decoration: none; color: var(--color-ink); }.insight h2 { max-width: 48rem; font-size: 1.9rem; }.insight > a:hover h2 { color: var(--color-accent); }
 .faq-section { display: grid; grid-template-columns: .8fr 1.2fr; gap: 3rem; }
 @media(max-width: 900px) { .hero { gap: 2rem; }.hero-photo { height: 390px; }.hero h1 { font-size: 3.5rem; }.service-grid { gap: 1rem; }.employer-panel { padding: 2rem; gap: 2rem; } }
 @media(max-width: 720px) { .hero { grid-template-columns: 1fr; padding-top: 1rem; }.hero h1 { font-size: clamp(3rem, 11vw, 4.5rem); }.hero-visual { max-width: 440px; width: 100%; margin: 0 auto; }.hero-photo { height: 360px; }.proof-strip { grid-template-columns: 1fr 1fr; gap: 1.5rem; }.proof-strip .platform-line { grid-column: 1 / -1; padding: 0; border: 0; }.results-grid, .service-grid, .employer-panel, .faq-section, .philosophy { grid-template-columns: 1fr; }.recommendation { padding: 1.5rem; }.recommendation blockquote { font-size: 1.3rem; }.quote-credit { display: block; }.quote-credit > a { display: inline-block; margin-top: 1.25rem; }.career-preview { padding: 1.5rem 0 0; border-left: 0; border-top: 1px solid #455467; }.result-card { padding: 1.5rem; }.hero .cta-buttons { gap: 1rem; } }
</style>
