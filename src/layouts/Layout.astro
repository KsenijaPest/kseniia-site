---
export interface Props {
  title: string;
  description: string;
  schema?: object | object[];
}

const { title, description, schema } = Astro.props;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | Kseniia Shermin</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Kseniia Shermin`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Kseniia Shermin`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!--
      Cloudflare Web Analytics: cookie-free, no consent banner required.
      Uncomment once a Cloudflare Web Analytics token exists.

      <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "REPLACE_ME"}'></script>
    -->

    <script is:inline>
      const GA4_ID = 'G-ZSQEP4F77K';
      const CLARITY_ID = 'y4fkcqivic';

      function loadGA4() {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(...args) { window.dataLayer.push(args); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA4_ID);
      }

      function loadClarity() {
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', CLARITY_ID);
      }

      if (localStorage.getItem('cookie-consent') === 'accepted') {
        loadGA4();
        loadClarity();
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo">Kseniia Shermin</a>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="nav-links" id="nav-links">
          <a href="/services">Work With Me</a>
          <a href="/for-employers">Hire Me</a>
          <a href="/case-studies">Case Studies</a>
          <a href="/about">About</a>
          <a href="/contact" class="nav-cta">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Kseniia Shermin. Performance Marketing Manager.</p>
      <p class="footer-links">
        <a href="https://www.linkedin.com/in/kseniiashermin/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </footer>

    <div class="cookie-banner" id="cookie-banner" hidden>
      <p>This site uses analytics cookies to understand traffic. Declining won't affect your experience.</p>
      <div class="cookie-banner-actions">
        <button type="button" class="btn btn-secondary" id="cookie-decline">Decline</button>
        <button type="button" class="btn btn-primary" id="cookie-accept">Accept</button>
      </div>
    </div>

    <script is:inline>
      const banner = document.getElementById('cookie-banner');
      const consent = localStorage.getItem('cookie-consent');

      if (consent !== 'accepted' && consent !== 'declined') {
        banner?.removeAttribute('hidden');
      }

      document.getElementById('cookie-accept')?.addEventListener('click', () => {
        localStorage.setItem('cookie-consent', 'accepted');
        banner?.setAttribute('hidden', '');
        loadGA4();
        loadClarity();
      });

      document.getElementById('cookie-decline')?.addEventListener('click', () => {
        localStorage.setItem('cookie-consent', 'declined');
        banner?.setAttribute('hidden', '');
      });
    </script>

    <script is:inline>
      const toggle = document.querySelector('.nav-toggle');
      const links = document.getElementById('nav-links');
      toggle?.addEventListener('click', () => {
        const isOpen = links?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(!!isOpen));
      });
      links?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          links.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-ink: #14161f;
    --color-bg: #ffffff;
    --color-accent: #2563eb;
    --color-accent-light: #eaf1ff;
    --color-muted: #6b7280;
    --color-line: #e5e7eb;
    --font-serif: 'Georgia', 'Times New Roman', serif;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--color-bg);
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.6;
  }

  h1, h2, h3 {
    font-family: var(--font-serif);
    line-height: 1.2;
    margin: 0 0 0.5em;
  }

  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }

  a { color: var(--color-accent); }

  .site-header {
    border-bottom: 1px solid var(--color-line);
    padding: 1rem 2rem;
  }

  .nav {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-serif);
    font-weight: bold;
    text-decoration: none;
    color: var(--color-ink);
    font-size: 1.1rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--color-ink);
    font-size: 0.95rem;
  }

  .nav-links a:hover { color: var(--color-accent); }

  .nav-cta {
    background: var(--color-accent);
    color: white !important;
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
  }

  .nav-cta:hover { background: #1d4ed8; }

  @media (max-width: 768px) {
    .nav-toggle { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-line);
      padding: 0.5rem 2rem 1rem;
    }

    .nav-links.open { display: flex; }

    .nav-links a {
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-line);
    }

    .nav-links a:last-child { border-bottom: none; }

    .nav-cta {
      margin-top: 0.75rem;
      text-align: center;
    }

    .nav { position: relative; }
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .site-footer {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-line);
    margin-top: 4rem;
  }

  .footer-links a { color: var(--color-muted); }

  section { margin-bottom: 4rem; }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    text-align: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .btn-primary {
    background: var(--color-accent);
    color: white !important;
    border: 1px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: #1d4ed8;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-accent) !important;
    border: 1px solid var(--color-accent);
  }

  .btn-secondary:hover {
    background: var(--color-accent-light);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-buttons .btn { min-width: 190px; }

  .stats-row {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin: 2rem 0;
  }

  .stat { min-width: 140px; }
  .stat-number {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    color: var(--color-accent);
    display: block;
  }
  .stat-label { color: var(--color-muted); font-size: 0.9rem; }

  .split-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .split-cards { grid-template-columns: 1fr; }
  }

  .split-card {
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 1px 3px rgba(20, 22, 31, 0.04);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-line);
    padding: 1.25rem 0;
  }

  .faq-item h3 { font-family: var(--font-sans); font-size: 1.05rem; margin-bottom: 0.4rem; }

  .updated-note {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  .tldr {
    background: var(--color-accent-light);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    font-size: 1.05rem;
  }

  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    box-shadow: 0 -4px 20px rgba(20, 22, 31, 0.08);
    padding: 0.85rem 2rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
    max-width: 640px;
  }

  .cookie-banner-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cookie-banner-actions .btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .cookie-banner { flex-direction: column; align-items: stretch; }
    .cookie-banner-actions { justify-content: stretch; }
    .cookie-banner-actions .btn { flex: 1; }
  }
</style>
