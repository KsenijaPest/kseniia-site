---
import Layout from '../layouts/Layout.astro';

import { caseStudies } from '../data/case-studies';

---

<Layout
  title="PPC & Paid Search Case Studies"
  description="Real results managing paid search and paid social accounts for lead generation and e-commerce businesses."
>
  <section>
    <h1>Paid Search &amp; PPC Case Studies</h1>
    <p>Case studies drawn from real accounts I've managed. Results reflect those specific accounts, roles, and time periods. They are not a guarantee of future results.</p>
  </section>

  {caseStudies.map((cs, index) => (
    <section id={`case-${index + 1}`} class="split-card case-study" style="margin-bottom: 2rem;">
      <div class="case-infographic">
        <strong>{cs.stat.number}</strong>
        <span>{cs.stat.label}</span>
        <p>{cs.stat.secondary}</p>
      </div>

      <p class="stat-label">{cs.vertical}</p>
      <h2>{cs.name}</h2>
      <p><strong>Context:</strong> {cs.context}</p>
      {cs.budget && <p><strong>Budget scale:</strong> {cs.budget}</p>}
      <p><strong>Platforms:</strong> {cs.platforms}</p>
      <p><strong>What I did:</strong></p>
      <ul>
        {cs.actions.map((a) => <li>{a}</li>)}
      </ul>
      <p><strong>Result:</strong> {cs.result}</p>
      {cs.sourceUrl && (
        <p><a href={cs.sourceUrl} target="_blank" rel="noopener">{cs.sourceLabel}</a></p>
      )}
    </section>
  ))}

  <section class="closing-cta">
    <p class="eyebrow">YOUR NEXT STEP</p>
    <h2>Let's look at your account.</h2>
    <p>Request a paid audit for a prioritized list of what to fix, or book a free intro call to discuss what you need.</p>
    <div class="cta-buttons">
      <a href="/contact/?interest=Audit" class="btn btn-primary">Request an audit &rarr;</a>
      <a href="https://cal.com/kseniiashermin/15min" class="btn btn-secondary" target="_blank" rel="noopener">Book an intro call &nearr;</a>
    </div>
    <p>Hiring? <a href="/for-employers/">Explore my experience and approach &rarr;</a></p>
  </section>
</Layout>

<style>
  .case-infographic {
    padding: 2rem;
    background: var(--color-accent-light);
    margin-bottom: 1.5rem;
    border-radius: 12px;
  }
  .case-infographic strong { display: block; font-size: clamp(2.8rem, 7vw, 4.5rem); line-height: 1.15; letter-spacing: -.05em; color: var(--color-accent); }
  .case-infographic span { font-weight: 600; }
  .case-infographic p { margin-bottom: 0; font-size: .9rem; }
  @media(max-width: 640px) { .case-infographic { padding: 1.25rem; } }
</style>
