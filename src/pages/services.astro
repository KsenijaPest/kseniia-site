---
import Layout from '../layouts/Layout.astro';
import { getLastUpdated } from '../lib/updated';

const NDA_ANSWER = "Yes, if needed.";
const LAST_UPDATED = getLastUpdated();

const faqs = [
  {
    q: "What's included in a paid search audit?",
    a: "A full review of account structure, tracking accuracy, budget allocation, and bidding strategy across Google Ads and/or Microsoft Ads, with a prioritized list of what to fix first."
  },
  {
    q: "Do you work with e-commerce accounts?",
    a: "Yes, I have experience with large appliance e-commerce (30,000+ items) and I've worked across a wide range of consumer product categories, from electronics and home goods to outdoor, personal care, and apparel."
  },
  {
    q: "Which platforms do you work with?",
    a: "Google Ads, Microsoft Ads, Meta Ads, LinkedIn Ads, and other PPC platforms depending on where your audience is."
  },
  {
    q: "Which industries have you worked in?",
    a: "Health insurance (ACA, U65, and Medicare O65), life and final expense insurance, auto and home insurance, mental health and behavioral health treatment, telecom and internet service providers, e-commerce, including home appliances and consumer goods, and B2B SaaS."
  },
  {
    q: "Do you sign NDAs?",
    a: NDA_ANSWER
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const servicesSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Google Ads / Microsoft Ads / Meta Ads Audit",
    "provider": { "@type": "Person", "name": "Kseniia Shermin" },
    "description": "A full review of account structure, tracking accuracy, budget allocation, and bidding strategy, with a prioritized list of what to fix first."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Performance Marketing Consultation",
    "provider": { "@type": "Person", "name": "Kseniia Shermin" },
    "description": "A focused strategy session on paid search or paid social for lead generation accounts."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Paid Search & Paid Social Management",
    "provider": { "@type": "Person", "name": "Kseniia Shermin" },
    "description": "Ongoing management of Google Ads, Microsoft Ads, and/or Meta Ads accounts for lead generation."
  }
];
---

<Layout
  title="PPC & Paid Search Services"
  description="Audits, consultations, and account management for Google Ads, Microsoft Ads, and Meta Ads, focused on lead generation for B2C, B2B, and service businesses."
  schema={[faqSchema, ...servicesSchema]}
>
  <section>
    <h1>Work With Me</h1>
    <p>Lead generation focused paid search and paid social, for B2C, B2B, and service businesses.</p>
  </section>

  <section id="audit">
    <h2>Audit</h2>
    <p>A full review of account structure, tracking accuracy, budget allocation, and bidding strategy across Google Ads and/or Microsoft Ads, with a prioritized list of what to fix first.</p>
    <a href="/contact?interest=Audit" class="btn btn-primary">Request an Audit</a>
  </section>

  <section id="consultation">
    <h2>Consultation</h2>
    <p>A focused strategy session. Bring your specific questions or roadblocks, leave with a concrete plan.</p>
    <a href="/contact?interest=Consultation" class="btn btn-secondary">Book a Call</a>
  </section>

  <section id="management">
    <h2>Account Management</h2>
    <p>Ongoing, hands-on management of your Google Ads, Microsoft Ads, and/or Meta Ads accounts, built around a predictable lead pipeline.</p>
    <a href="/contact?interest=Ongoing management" class="btn btn-secondary">Get in Touch</a>
  </section>

  <section>
    <h2>FAQ</h2>
    {faqs.map((item) => (
      <div class="faq-item">
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </div>
    ))}
    <p class="updated-note">Updated: {LAST_UPDATED}</p>
  </section>
</Layout>
