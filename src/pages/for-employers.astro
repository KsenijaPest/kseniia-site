---
import Layout from '../layouts/Layout.astro';
import { getLastUpdated } from '../lib/updated';

const LAST_UPDATED = getLastUpdated();
---

<Layout
  title="For Employers"
  description="Performance Marketing Manager with 10+ years of experience managing large-scale paid search and paid social accounts. Open to full-time and fractional roles."
>
  <section>
    <h1>Looking to Hire a Performance Marketing Manager</h1>
    <p>
      10+ years running paid search and paid social, including Google Ads, Microsoft Ads,
      Meta Ads, and LinkedIn Ads, with hands-on experience managing accounts spending
      over $100,000 per day. Focused on lead generation for B2C, B2B, and service businesses.
    </p>
    <!-- TODO: add resume download link, LinkedIn link, and specific role interests (full-time / fractional / relocation-open) -->
    <div class="cta-buttons">
      <a href="/about" class="btn btn-secondary">Read Full Background &rarr;</a>
      <a href="/contact?interest=Full-time / fractional role" class="btn btn-primary">Get in Touch</a>
    </div>

    <div class="stats-row">
      <div class="stat">
        <span class="stat-number">10+</span>
        <span class="stat-label">Years of experience</span>
      </div>
      <div class="stat">
        <span class="stat-number">$100K+</span>
        <span class="stat-label">Daily ad spend managed</span>
      </div>
      <div class="stat">
        <span class="stat-number">5X-36X</span>
        <span class="stat-label">Account growth delivered</span>
      </div>
    </div>
    <p class="updated-note">Updated: {LAST_UPDATED}</p>
  </section>

  <section>
    <h2>What I Bring</h2>
    <div class="split-cards">
      <div class="split-card">
        <h3>Scale</h3>
        <p>Direct experience managing large, complex accounts across multiple platforms simultaneously.</p>
      </div>
      <div class="split-card">
        <h3>Process, not just execution</h3>
        <p>I build repeatable tracking, testing, and reporting systems, not one-off campaign wins.</p>
      </div>
      <div class="split-card">
        <h3>Range across industries</h3>
        <p>Health insurance (ACA, U65, Medicare O65), life and final expense, auto and home insurance, mental health treatment, telecom, e-commerce, and B2B SaaS. See the full breakdown on the <a href="/#industries">industries page</a>.</p>
      </div>
      <div class="split-card">
        <h3>Team leadership</h3>
        <p>Recruited, trained, and managed teams of PPC specialists, not just individual-contributor campaign work.</p>
      </div>
    </div>
  </section>

  <section>
    <h2>Want the Details?</h2>
    <p>Full account history and results are on the <a href="/case-studies">case studies page</a>, and the complete career timeline is on the <a href="/about">about page</a>.</p>
  </section>
</Layout>
