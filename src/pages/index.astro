---
import Layout from '../layouts/Layout.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Kseniia Shermin",
  "jobTitle": "Performance Marketing Manager",
  "description": "Performance Marketing Manager specializing in lead generation at scale across Google Ads, Microsoft Ads, and Meta Ads.",
  "url": "https://kseniiashermin.com",
  "sameAs": [
    "https://www.linkedin.com/in/kseniiashermin/"
  ]
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Kseniia Shermin - Performance Marketing",
  "description": "Lead generation focused paid search and paid social consulting for B2C, B2B, and service businesses. Google Ads, Microsoft Ads, and Meta Ads audits, consultations, and account management.",
  "areaServed": "Worldwide",
  "priceRange": "$$$"
};
---

<Layout
  title="Performance Marketing Manager | Lead Gen at Scale"
  description="10+ years running paid search and paid social for B2C, B2B, and service businesses. Google Ads, Microsoft Ads, and Meta Ads accounts spending over $100,000/day."
  schema={[personSchema, professionalServiceSchema]}
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-main">
        <h1>Performance Marketing Manager for Lead Gen at Scale</h1>
        <div class="tldr">
          10+ years running paid search and paid social for B2C, B2B, and service businesses.
          Managing Google Ads and Microsoft Ads accounts spending over $100,000 per day,
          plus Meta Ads, LinkedIn Ads, and virtually any pay-per-click platform.
        </div>

        <div class="stats-row">
          <div class="stat">
            <span class="stat-number">10+</span>
            <span class="stat-label">Years of experience</span>
          </div>
          <div class="stat">
            <span class="stat-number">$100K+</span>
            <span class="stat-label">Daily ad spend managed</span>
          </div>
          <div class="stat">
            <span class="stat-number">5X-36X</span>
            <span class="stat-label">Account growth delivered</span>
          </div>
        </div>
      </div>
      <div class="hero-actions">
        <a href="/services#audit" class="btn btn-primary">Request an Audit</a>
        <a href="/contact" class="btn btn-secondary">Book a Call</a>
      </div>
    </div>
  </section>

  <section class="platforms">
    <h2>Deep Platform Expertise</h2>
    <p>
      Paid search is where I live. Over 10 years running Google Ads and Microsoft Ads
      accounts at scale means knowing the auction mechanics, the bid strategy tradeoffs,
      and the reporting quirks well enough to know when to trust the platform's automation
      and when to override it.
    </p>
    <div class="split-cards">
      <div class="split-card platform-card">
        <svg class="platform-logo" viewBox="0 0 48 48" width="40" height="40" role="img" aria-label="Google Ads">
          <path fill="#4285F4" d="M24 9.5c3.4 0 6.4 1.2 8.8 3.5l6.6-6.6C35.5 2.6 30.1 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.7 6c1.8-5.5 7-9.7 13.7-9.7Z"/>
          <path fill="#34A853" d="M46.5 24.5c0-1.6-.1-3.2-.4-4.7H24v9h12.6c-.5 3-2.2 5.5-4.7 7.2l7.3 5.7c4.3-4 6.8-9.9 6.8-17.2Z"/>
          <path fill="#FBBC05" d="M10.3 28.5a14.5 14.5 0 0 1 0-9l-7.7-6a24 24 0 0 0 0 21l7.7-6Z"/>
          <path fill="#EA4335" d="M24 48c6.1 0 11.3-2 15-5.5l-7.3-5.7c-2 1.4-4.7 2.2-7.7 2.2-6.6 0-12.2-4.5-14.2-10.5l-7.7 6C6.5 42.6 14.6 48 24 48Z"/>
        </svg>
        <h3>Google Ads</h3>
        <p>Search, Display, Performance Max, Shopping, and YouTube. Comfortable building account structures for scale, tuning Smart Bidding strategies, and getting conversion tracking right before touching anything else.</p>
      </div>
      <div class="split-card platform-card">
        <svg class="platform-logo" viewBox="0 0 24 24" width="40" height="40" role="img" aria-label="Microsoft Ads">
          <rect x="1" y="1" width="10" height="10" fill="#F25022"/>
          <rect x="13" y="1" width="10" height="10" fill="#7FBA00"/>
          <rect x="1" y="13" width="10" height="10" fill="#00A4EF"/>
          <rect x="13" y="13" width="10" height="10" fill="#FFB900"/>
        </svg>
        <h3>Microsoft Ads</h3>
        <p>Microsoft Ads is not just an import job from Google Ads. It's a genuinely different platform with its own auction dynamics and audience network, and it rewards a different approach. Years of hands-on Microsoft Ads campaign management have consistently delivered strong traffic, lead quality, and ROI.</p>
      </div>
    </div>
    <p class="platforms-also"><strong>Also experienced with:</strong> Meta Ads, LinkedIn Ads, and other PPC platforms depending on where the audience actually is.</p>
  </section>

  <section class="split">
    <h2>How can I help you?</h2>
    <div class="split-cards">
      <div class="split-card">
        <h3>Looking to hire a Performance Marketing Manager</h3>
        <p>10+ years of in-house and agency-side experience managing large-scale lead gen accounts. See my background and career results.</p>
        <a href="/for-employers" class="btn btn-secondary">For Employers &rarr;</a>
      </div>
      <div class="split-card">
        <h3>Need an audit, consultation, or account management</h3>
        <p>A clear-eyed look at what's working and what isn't in your Google, Microsoft, or Meta Ads account, or ongoing management.</p>
        <a href="/services" class="btn btn-primary">Work With Me &rarr;</a>
      </div>
    </div>
  </section>

  <section class="philosophy">
    <h2>How I Work</h2>
    <p><strong>Start with the goal, not the tactic.</strong> I focus on the number that actually matters, usually lowering cost per action and scaling conversion volume at the same time, not one at the expense of the other.</p>
    <p><strong>Fix the foundation first.</strong> Before touching bids or creative, I make sure tracking and data are accurate. Every scaling decision after that is only as good as the data it's built on.</p>
    <p><strong>Then experiment relentlessly.</strong> Once the foundation is solid, I test across every layer of the account, including bidding strategy, audience signals, ad copy, and landing pages, to find what actually moves the number.</p>
  </section>

  <section class="cta">
    <h2>Ready to Turn Ad Spend Into Predictable Pipeline?</h2>
    <p>Not sure where to start? Book a free intro call. Want a full breakdown of what's working and what isn't in your account? Request a paid audit.</p>
    <div class="cta-buttons">
      <a href="/services#audit" class="btn btn-primary">Request an Audit</a>
      <a href="/contact" class="btn btn-secondary">Book a Call</a>
    </div>
  </section>
</Layout>

<style>
  .platform-card { text-align: left; }
  .platform-logo { margin-bottom: 1rem; display: block; }
  .platforms-also { color: var(--color-muted); }

  .hero-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
  }
  .hero-main { flex: 1; min-width: 0; }
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 200px;
    padding-top: 0.5rem;
  }
  .hero-actions .btn { text-align: center; }

  @media (max-width: 768px) {
    .hero-grid { flex-direction: column; }
    .hero-actions { flex-direction: row; width: 100%; }
    .hero-actions .btn { flex: 1; }
  }
</style>
