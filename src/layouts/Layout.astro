---
export interface Props {
  title: string;
  description: string;
  schema?: object | object[];
}

const { title, description, schema } = Astro.props;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | Kseniia Shermin</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Kseniia Shermin`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | Kseniia Shermin`} />
    <meta name="twitter:description" content={description} />

    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!--
      Analytics placeholders: GA4, Cloudflare Web Analytics, Microsoft Clarity.
      Intentionally left commented out until the cookie-consent banner is wired up.
      Cloudflare Web Analytics does not use cookies and can be enabled immediately.

      <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "REPLACE_ME"}'></script>
    -->
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo">Kseniia Shermin</a>
        <div class="nav-links">
          <a href="/services">Work With Me</a>
          <a href="/for-employers">Hire Me</a>
          <a href="/case-studies">Case Studies</a>
          <a href="/about">About</a>
          <a href="/contact" class="nav-cta">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Kseniia Shermin. Performance Marketing Manager.</p>
      <p class="footer-links">
        <a href="https://www.linkedin.com/in/kseniiashermin/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-ink: #16181d;
    --color-bg: #fdfcfa;
    --color-accent: #1a5f4a;
    --color-muted: #6b7178;
    --color-line: #e6e3dd;
    --font-serif: 'Georgia', 'Times New Roman', serif;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--color-bg);
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.6;
  }

  h1, h2, h3 {
    font-family: var(--font-serif);
    line-height: 1.2;
    margin: 0 0 0.5em;
  }

  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }

  a { color: var(--color-accent); }

  .site-header {
    border-bottom: 1px solid var(--color-line);
    padding: 1rem 2rem;
  }

  .nav {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-serif);
    font-weight: bold;
    text-decoration: none;
    color: var(--color-ink);
    font-size: 1.1rem;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--color-ink);
    font-size: 0.95rem;
  }

  .nav-cta {
    background: var(--color-accent);
    color: white !important;
    padding: 0.5rem 1rem;
    border-radius: 4px;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .site-footer {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-line);
    margin-top: 4rem;
  }

  .footer-links a { color: var(--color-muted); }

  section { margin-bottom: 4rem; }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
  }

  .btn-primary {
    background: var(--color-accent);
    color: white !important;
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-ink) !important;
    border: 1px solid var(--color-ink);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stats-row {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin: 2rem 0;
  }

  .stat { min-width: 140px; }
  .stat-number {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    color: var(--color-accent);
    display: block;
  }
  .stat-label { color: var(--color-muted); font-size: 0.9rem; }

  .split-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .split-cards { grid-template-columns: 1fr; }
  }

  .split-card {
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 2rem;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-line);
    padding: 1.25rem 0;
  }

  .faq-item h3 { font-family: var(--font-sans); font-size: 1.05rem; margin-bottom: 0.4rem; }

  .updated-note {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  .tldr {
    background: #f4f2ec;
    border-left: 3px solid var(--color-accent);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    font-size: 1.05rem;
  }
</style>
