---
import ContactForm from './ContactForm.astro';
import { testimonials } from '../data/testimonials';
const { standalone = false } = Astro.props;
const review = testimonials[3];
---
<section class="contact-section" id="contact" aria-labelledby="contact-heading">
  <div class="contact-copy">
    <p class="eyebrow">LET'S TALK</p>
    {standalone ? <h1 id="contact-heading">What's next for your paid search?</h1> : <h2 id="contact-heading">What's next for your paid search?</h2>}
    <p>Tell me a bit about your account and what you're looking for, and I'll follow up within 1-2 business days.</p>
    <p>Hiring for a full-time or fractional role? Tell me about the team and the opportunity.</p>
    <a class="text-link" href="https://cal.com/kseniiashermin/15min" target="_blank" rel="noopener">Prefer to talk? Book a free intro call &nearr;</a>
    <figure class="contact-proof">
      <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
      <blockquote>{review.quote}</blockquote>
      <figcaption>{review.context}</figcaption>
    </figure>
  </div>
  <div class="form-panel" id="contact-form"><ContactForm /></div>
</section>
<style>
 .contact-section { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); border-top: 1px solid var(--color-line); padding-top: 5rem; }
 h1, h2 { font-size: clamp(2.3rem, 4vw, 3.4rem); }
 .contact-copy > p { max-width: 30rem; }
 .form-panel { padding: 2rem; border: 1px solid var(--color-line); background: white; border-radius: 12px; }
 .contact-proof { margin: 2.5rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--color-line); }
 blockquote { margin: .75rem 0; font-size: 1.1rem; }
 figcaption { color: var(--color-muted); font-size: .8rem; }
 .stars { color: #926510; letter-spacing: .15em; }
 @media(max-width: 720px) { .contact-section { grid-template-columns: 1fr; padding-top: 3rem; } .form-panel { padding: 1.25rem; } }
</style>
