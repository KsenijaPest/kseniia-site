---
export interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  noindex?: boolean;
  article?: boolean;
  ogImage?: string;
}

const { title, description, schema, noindex, article = false, ogImage } = Astro.props;
const schemaArray = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage ?? '/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="msvalidate.01" content="B3B2170B78FD3175B1A1D764F061F1B1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} | Kseniia Shermin</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <noscript><style>
      @media(max-width: 768px) {
        .site-header { position: relative !important; }
        .nav { flex-wrap: wrap !important; }
        .nav-toggle { display: none !important; }
        .nav-links { display: flex !important; position: static !important; width: 100%; box-shadow: none !important; }
      }
    </style></noscript>
    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={`${title} | Kseniia Shermin`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Kseniia Shermin`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!--
      Cloudflare Web Analytics: cookie-free, no consent banner required.
      Uncomment once a Cloudflare Web Analytics token exists.

      <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "REPLACE_ME"}'></script>
    -->

    <script is:inline>
      const GA4_ID = 'G-ZSQEP4F77K';
      const CLARITY_ID = 'y4fkcqivic';
      const CONSENT_MAX_AGE_MS = 365 * 24 * 60 * 60 * 1000;
      let analyticsLoaded = false;
      let consentState = null;
      try {
        const stored = localStorage.getItem('cookie-consent');
        const storedAt = Number(localStorage.getItem('cookie-consent-at'));
        if ((stored === 'accepted' || stored === 'declined') && storedAt && Date.now() - storedAt < CONSENT_MAX_AGE_MS) {
          consentState = stored;
        }
      } catch {}
      // Global Privacy Control and Do Not Track count as a decline when the visitor has made no explicit choice.
      if (consentState === null && (navigator.globalPrivacyControl === true || navigator.doNotTrack === '1' || window.doNotTrack === '1')) {
        consentState = 'declined';
      }
      function saveConsent(value) {
        consentState = value;
        try {
          localStorage.setItem('cookie-consent', value);
          localStorage.setItem('cookie-consent-at', String(Date.now()));
        } catch {}
      }
      function clearAnalyticsCookies() {
        const names = document.cookie.split(';').map((c) => c.split('=')[0].trim())
          .filter((n) => /^(_ga|_gid|_gat|_clck|_clsk|CLID|ANONCHK|MR|MUID|SM|SRM_B)/.test(n));
        const parts = location.hostname.split('.');
        const domains = new Set([location.hostname]);
        for (let i = 0; i <= parts.length - 2; i++) domains.add('.' + parts.slice(i).join('.'));
        names.forEach((name) => {
          const expired = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
          document.cookie = expired;
          domains.forEach((domain) => { document.cookie = expired + '; domain=' + domain; });
        });
      }
      function trackInquiryEvent(name, parameters) {
        if (consentState === 'accepted' && typeof window.gtag === 'function') {
          window.gtag('event', name, parameters);
        }
      }
      document.addEventListener('inquiry-analytics', (event) => {
        const { name, source, intent } = event.detail;
        if (['inquiry_start', 'form_submission'].includes(name)) {
          trackInquiryEvent(name, { form_source: source, inquiry_intent: intent });
        }
      });
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a') : null;
        if (!link) return;
        const placement = link.dataset.cta || (link.closest('header') ? 'header' : link.closest('dialog') ? 'hero-dialog' : location.pathname);
        if (link.href.startsWith('https://cal.com/kseniiashermin/')) {
          trackInquiryEvent('booking_link_click', { placement });
        } else if (link.hasAttribute('data-cta') || link.getAttribute('href')?.includes('contact')) {
          trackInquiryEvent('inquiry_cta_click', { placement });
        }
      });

      function loadGA4() {
        if (analyticsLoaded) return;
        analyticsLoaded = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA4_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
      }

      function loadClarity() {
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', CLARITY_ID);
        window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'granted' });
      }

      if (consentState === 'accepted') {
        loadGA4();
        loadClarity();
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo">Kseniia Shermin<span>PERFORMANCE MARKETING</span></a>
        <a href="/#contact" class="mobile-cta">Let's talk &rarr;</a>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="nav-links" id="nav-links">
          <a href="/#services">Services</a>
          <a href="/for-employers/">For Employers</a>
          <a href="/#results">Results</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
          <a href="/#contact" class="nav-cta">Let's talk &rarr;</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Kseniia Shermin. Performance Marketing Manager.</p>
      <p class="footer-links">
        <a href="https://www.linkedin.com/in/kseniiashermin/" target="_blank" rel="noopener">Kseniia Shermin on LinkedIn</a>
        <span class="footer-sep">&middot;</span>
        <a href="/privacy-policy/">Privacy Policy</a>
        <span class="footer-sep">&middot;</span>
        <a href="/terms/">Terms</a>
        <span class="footer-sep">&middot;</span>
        <a href="/accessibility/">Accessibility</a>
        <span class="footer-sep">&middot;</span>
        <button type="button" class="link-button" id="cookie-settings">Cookie settings</button>
      </p>
    </footer>

    <div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie consent" hidden>
      <p>With your permission, this site uses Google Analytics and Microsoft Clarity (which records how visitors click and scroll) to understand and improve the site. Nothing loads unless you accept. <a href="/privacy-policy/">Privacy policy</a></p>
      <div class="cookie-banner-actions">
        <button type="button" class="btn consent-btn" id="cookie-decline">Decline</button>
        <button type="button" class="btn consent-btn" id="cookie-accept">Accept</button>
      </div>
    </div>

    <script is:inline>
      const banner = document.getElementById('cookie-banner');

      if (consentState !== 'accepted' && consentState !== 'declined') {
        banner?.removeAttribute('hidden');
      }

      document.getElementById('cookie-accept')?.addEventListener('click', () => {
        saveConsent('accepted');
        banner?.setAttribute('hidden', '');
        loadGA4();
        loadClarity();
      });

      document.getElementById('cookie-decline')?.addEventListener('click', () => {
        const wasLoaded = analyticsLoaded;
        saveConsent('declined');
        banner?.setAttribute('hidden', '');
        if (wasLoaded) {
          clearAnalyticsCookies();
          location.reload();
        }
      });

      document.getElementById('cookie-settings')?.addEventListener('click', () => {
        banner?.removeAttribute('hidden');
        document.getElementById('cookie-decline')?.focus();
      });
    </script>

    <script is:inline>
      const toggle = document.querySelector('.nav-toggle');
      const links = document.getElementById('nav-links');
      toggle?.addEventListener('click', () => {
        const isOpen = links?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(!!isOpen));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && links?.classList.contains('open')) {
          links.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
          toggle?.focus();
        }
      });
      links?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          links.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!reducedMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('entered');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll('main > section:not(.hero), .result-card, .split-card').forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-ink: #172538;
    --color-bg: #f8f8f4;
    --color-accent: #2459b8;
    --color-accent-light: #edf1f8;
    --color-muted: #596270;
    --color-line: #d8dce0;
    --font-serif: 'Georgia', 'Times New Roman', serif;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--color-bg);
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.6;
  }

  h1, h2, h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: 1.15;
    margin: 0 0 0.5em;
  }

  h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }

  a { color: var(--color-accent); }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    padding: 1rem 2rem;
  }

  .nav {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .logo {
    font-family: var(--font-sans);
    font-weight: 650;
    text-decoration: none;
    color: var(--color-ink);
    font-size: 1.1rem;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--color-ink);
    font-size: 0.95rem;
  }

  .nav-links a:hover { color: var(--color-accent); }

  .nav-cta {
    background: var(--color-accent);
    color: white !important;
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
  }

  .nav-cta:hover { background: #1d4ed8; }

  @media (max-width: 768px) {
    .nav-toggle { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-line);
      padding: 0.5rem 2rem 1rem;
    }

    .nav-links.open { display: flex; }

    .nav-links a {
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-line);
    }

    .nav-links a:last-child { border-bottom: none; }

    .nav-cta {
      margin-top: 0.75rem;
      text-align: center;
    }

    .nav { position: relative; }
  }

  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  .site-footer {
    text-align: center;
    padding: 3rem 2rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-line);
    margin-top: 4rem;
  }

  .footer-links a { color: var(--color-muted); }
  .footer-sep { margin: 0 0.5rem; }

  section { margin-bottom: 5.5rem; }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    text-align: center;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .btn-primary {
    background: var(--color-accent);
    color: white !important;
    border: 1px solid var(--color-accent);
  }

  .btn-primary:hover {
    background: #1d4ed8;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-accent) !important;
    border: 1px solid var(--color-accent);
  }

  .btn-secondary:hover {
    background: var(--color-accent-light);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-buttons .btn { min-width: 190px; }

  .stats-row {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin: 2rem 0;
  }

  .stat { min-width: 140px; }
  .stat-number {
    font-family: var(--font-sans);
    font-size: 2.2rem;
    color: var(--color-accent);
    display: block;
  }
  .stat-label { color: var(--color-muted); font-size: 0.9rem; }

  .split-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .split-cards { grid-template-columns: 1fr; }
  }

  .split-card {
    background: white;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 1px 3px rgba(20, 22, 31, 0.04);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-line);
    padding: 1.25rem 0;
  }

  .faq-item h3 { font-family: var(--font-sans); font-size: 1.05rem; margin-bottom: 0.4rem; }

  .updated-note {
    color: var(--color-muted);
    font-size: 0.85rem;
    margin-top: 1rem;
  }

  .tldr {
    background: var(--color-accent-light);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    font-size: 1.05rem;
  }

  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    box-shadow: 0 -4px 20px rgba(20, 22, 31, 0.08);
    padding: 0.85rem 2rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-muted);
    max-width: 640px;
  }

  .cookie-banner-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cookie-banner-actions .btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
  }

  .consent-btn {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    cursor: pointer;
    font-family: inherit;
  }
  .consent-btn:hover { background: var(--color-accent-light); }

  .link-button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--color-muted);
    text-decoration: underline;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .cookie-banner { flex-direction: column; align-items: stretch; }
    .cookie-banner-actions { justify-content: stretch; }
    .cookie-banner-actions .btn { flex: 1; }
  }

  html { scroll-behavior: smooth; scroll-padding-top: 110px; }
  :focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }
  .skip-link { position: fixed; top: -100px; left: 1rem; z-index: 200; padding: .75rem 1.25rem; background: white; }
  .skip-link:focus { top: 1rem; }
  .logo span { display: block; font-size: .55rem; letter-spacing: .15em; color: var(--color-muted); margin-top: .1rem; }
  .mobile-cta { display: none; }
  .eyebrow { color: var(--color-accent); font-size: .65rem; letter-spacing: .14em; font-weight: 650; margin: 0 0 1rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2rem; }
  .section-heading h2 { margin-bottom: 0; }
  .text-link { font-size: .85rem; font-weight: 650; text-underline-offset: .3em; }
  .btn { font-size: .9rem; border-radius: 6px; }
  .btn:hover { transform: translateY(-2px); }
  .split-card, .result-card, .contact-proof { transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  .split-card:hover, .result-card:hover, .result-card:focus-visible { transform: translateY(-4px); border-color: #9aacc9; box-shadow: 0 12px 28px #1725380d; }
  .contact-proof:hover { transform: translateY(-2px); }
  .closing-cta { padding: 2.5rem; background: var(--color-accent-light); border-radius: 12px; }
  summary { cursor: pointer; font-weight: 600; padding: .5rem 0; }
  details[open] summary { color: var(--color-accent); }
  .faq-item p { color: var(--color-muted); margin-bottom: .25rem; }
  @keyframes entrance { from { opacity: .5; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  .entered { animation: entrance .65s ease; }
  @media(max-width: 768px) {
    .site-header { padding: .8rem 1.25rem; }
    .nav { flex-wrap: nowrap; gap: .85rem; }
    .logo { font-size: .95rem; margin-right: auto; }
    .mobile-cta { display: inline-block; font-size: .8rem; font-weight: 650; text-decoration: none; white-space: nowrap; }
    .nav-toggle { width: 28px; height: 44px; flex-shrink: 0; }
    .nav-links { top: calc(100% + .8rem); left: -1.25rem; right: -1.25rem; box-shadow: 0 14px 24px #17253815; }
    main { padding: 1.5rem 1.25rem; }
    section { margin-bottom: 3.75rem; }
    .section-heading { align-items: start; flex-direction: column; gap: 1rem; }
    .split-card { padding: 1.5rem; }
    .cookie-banner { padding: .8rem 1.25rem; }
  }
  @media(prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
