---
import ContactForm from './ContactForm.astro';
---
<dialog class="quick-inquiry" id="quick-inquiry" aria-labelledby="quick-inquiry-heading">
  <div class="quick-inquiry__header">
    <div>
      <p class="eyebrow">START THE CONVERSATION</p>
      <h2 id="quick-inquiry-heading" tabindex="-1" autofocus>How can I help?</h2>
      <p>Share the essentials. I'll follow up within 1-2 business days.</p>
    </div>
    <button class="quick-inquiry__close" type="button" aria-label="Close form" data-close-inquiry>&times;</button>
  </div>
  <ContactForm source="hero" compact />
  <p class="booking-option"><a href="https://cal.com/kseniiashermin/15min" target="_blank" rel="noopener">Prefer a free intro call? Choose a time &nearr;</a></p>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#quick-inquiry');
  const opener = document.querySelector<HTMLAnchorElement>('[data-open-inquiry]');
  if (dialog && typeof dialog.showModal === 'function') {
    opener?.setAttribute('aria-haspopup', 'dialog');
    opener?.setAttribute('aria-controls', dialog.id);
    opener?.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      dialog.showModal();
      document.documentElement.classList.add('inquiry-open');
    });
    dialog.querySelector('[data-close-inquiry]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('inquiry-open');
      opener?.focus();
    });
  }
</script>
<style>
  :global(html.inquiry-open) { overflow: hidden; }
  .quick-inquiry { width: min(100% - 2rem, 620px); max-height: calc(100dvh - 2rem); overflow-y: auto; overscroll-behavior: contain; border: 0; border-radius: 12px; padding: 2rem; background: var(--color-bg); color: var(--color-ink); box-shadow: 0 24px 70px rgba(23, 37, 56, .25); }
  .quick-inquiry::backdrop { background: rgba(23, 37, 56, .6); }
  .quick-inquiry__header { display: flex; justify-content: space-between; gap: 1.5rem; margin-bottom: 1rem; }
  .quick-inquiry__header h2 { font-size: 2rem; margin-bottom: .5rem; }
  .quick-inquiry__header p:not(.eyebrow) { color: var(--color-muted); margin: 0; }
  .quick-inquiry__close { width: 2.75rem; height: 2.75rem; flex: 0 0 auto; border: 1px solid var(--color-line); border-radius: 50%; background: white; color: var(--color-ink); font-size: 1.6rem; cursor: pointer; }
  .booking-option { font-size: .85rem; margin-bottom: 0; }
  @media (max-width: 640px) { .quick-inquiry { padding: 1.25rem; } .quick-inquiry__header h2 { font-size: 1.65rem; } }
</style>
