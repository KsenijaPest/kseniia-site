---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch for an audit, consultation, or ongoing account management."
>
  <section>
    <h1>Let's Talk</h1>
    <p>Tell me a bit about your account and what you're looking for, and I'll follow up within 1-2 business days.</p>
  </section>

  <section id="contact-form">
    <form action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value="067d94ff-2b9f-4d41-9199-09d942719de8" />
      <input type="hidden" name="redirect" value="https://kseniiashermin.com/thank-you" />

      <label for="name">Name</label>
      <input type="text" id="name" name="name" required />

      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />

      <label for="budget">Approximate monthly ad spend</label>
      <select id="budget" name="budget">
        <option>Under $10,000</option>
        <option>$10,000 - $50,000</option>
        <option>$50,000 - $200,000</option>
        <option>$200,000+</option>
      </select>

      <label for="interest">What are you looking for?</label>
      <select id="interest" name="interest">
        <option>Audit</option>
        <option>Consultation</option>
        <option>Ongoing management</option>
        <option>Full-time / fractional role</option>
      </select>

      <label for="message">Tell me more</label>
      <textarea id="message" name="message" rows="5"></textarea>

      <button type="submit" class="btn btn-primary">Send</button>
    </form>
  </section>

  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const interest = params.get('interest');
    const select = document.getElementById('interest');
    if (interest && select instanceof HTMLSelectElement) {
      const match = Array.from(select.options).find((o) => o.value === interest);
      if (match) select.value = interest;
    }
  </script>

  <section>
    <h2>Prefer to Book Directly?</h2>
    <p>
      <a href="https://cal.com/kseniiashermin/15min" class="btn btn-secondary" target="_blank" rel="noopener">Book a Call on Cal.com</a>
    </p>
  </section>
</Layout>

<style>
  form { display: flex; flex-direction: column; gap: 0.5rem; max-width: 500px; }
  label { font-weight: 600; margin-top: 0.75rem; }
  input, select, textarea {
    padding: 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    font-family: inherit;
    font-size: 1rem;
  }
  input:focus, select:focus, textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  button { margin-top: 1rem; align-self: flex-start; }
</style>
