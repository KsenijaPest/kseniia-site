    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h1>Let's get you to the right place.</h1>
    <p>This address doesn't lead to a page. Explore my paid search work or get in touch.</p>
    <div class="cta-buttons">
      <a class="btn btn-primary" href="/services/">Explore services &rarr;</a>
      <a class="btn btn-secondary" href="/case-studies/">See case studies &rarr;</a>
      <a class="text-link" href="/contact/">Contact me &rarr;</a>
    </div>
  </section>
</Layout>
