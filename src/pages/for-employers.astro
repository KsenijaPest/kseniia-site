---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="For Employers"
  description="Performance Marketing Manager with 10+ years of experience managing large-scale paid search and paid social accounts. Open to full-time and fractional roles."
>
  <section>
    <h1>Looking to Hire a Performance Marketing Manager</h1>
    <p>
      10+ years running paid search and paid social &mdash; Google Ads, Microsoft Ads,
      Meta Ads, LinkedIn Ads &mdash; with hands-on experience managing accounts spending
      over $100,000 per day. Focused on lead generation for B2B and service businesses.
    </p>
    <!-- TODO: add resume download link, LinkedIn link, and specific role interests (full-time / fractional / relocation-open) -->
    <div class="cta-buttons">
      <a href="/about" class="btn btn-secondary">Read Full Background &rarr;</a>
      <a href="/contact" class="btn btn-primary">Get in Touch</a>
    </div>
  </section>

  <section>
    <h2>What I Bring</h2>
    <div class="split-cards">
      <div class="split-card">
        <h3>Scale</h3>
        <p>Direct experience managing large, complex accounts across multiple platforms simultaneously.</p>
      </div>
      <div class="split-card">
        <h3>Process, not just execution</h3>
        <p>I build repeatable tracking, testing, and reporting systems &mdash; not one-off campaign wins.</p>
      </div>
    </div>
  </section>
</Layout>
